/**
 * ClubFix Service v3.0 - OFICIAL
 * Baseado 100% na documentação oficial: https://homolog.clubfix.com.br/webservice
 * 
 * ENDPOINTS PRINCIPAIS:
 * - POST /auth/login - Autenticação
 * - POST /customers - Criar cliente
 * - GET /brands - Listar marcas
 * - GET /brands/{id}/models - Listar modelos de uma marca
 * - GET /plans - Listar planos
 * - GET /quotation - Cotar todos os planos
 * - GET /plans/{planId}/quotation - Cotar um plano específico
 * - POST /subscriptions - Criar assinatura
 * - POST /subscriptions/{id}/payment - Processar pagamento
 */

const axios = require('axios');

class ClubFixServiceV3 {
    constructor() {
        // USA A URL DE PRODUÇÃO (pois as credenciais são de produção)
        this.baseURL = process.env.CLUBFIX_BASE_URL || 'https://clubfix.com.br/webservice';
        this.clientId = process.env.CLUBFIX_CLIENT_ID;
        this.clientSecret = process.env.CLUBFIX_CLIENT_SECRET;
        this.email = process.env.CLUBFIX_EMAIL || 'kainow@clubfix.com.br';
        this.password = process.env.CLUBFIX_PASSWORD || 'Kainow@27923746';
        
        this.token = {
            accessToken: null,
            expiresAt: null
        };
        
        // Cache para otimização
        this.cache = {
            brands: null,
            models: {},
            plans: null,
            lastUpdate: null
        };

        // Cliente HTTP
        this.client = axios.create({
            baseURL: this.baseURL,
            timeout: 30000,
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });

        console.log('📱 ClubFix Service v3.0 OFICIAL (PRODUÇÃO) inicializado');
        console.log(`Base URL: ${this.baseURL}`);
        console.log('⚠️ Usando URL de PRODUÇÃO (credenciais de produção)');
    }

    /**
     * Retorna informações do serviço
     */
    getInfo() {
        return {
            baseURL: this.baseURL,
            authenticated: !!this.token.accessToken,
            tokenExpiresAt: this.token.expiresAt,
            cacheStats: {
                brands: this.cache.brands ? this.cache.brands.length : 0,
                models: Object.keys(this.cache.models).length,
                plans: this.cache.plans ? this.cache.plans.length : 0,
                lastUpdate: this.cache.lastUpdate
            }
        };
    }

    /**
     * AUTENTICAÇÃO - Conforme Documentação Oficial
     * POST /auth/login
     * Header: X-CREDENTIALS: base64(email:password)
     * Body: { client_id, client_secret }
     * Response: { access_token, token_type, expires_in }
     */
    async authenticate() {
        if (!this.clientId || !this.clientSecret) {
            throw new Error('CLIENT_ID e CLIENT_SECRET são obrigatórios');
        }

        if (!this.email || !this.password) {
            throw new Error('EMAIL e PASSWORD são obrigatórios');
        }

        console.log('\n🔐 Autenticando na API ClubFix OFICIAL...');
        console.log(`Email: ${this.email}`);
        console.log(`Client ID: ${this.clientId}`);
        console.log(`Base URL: ${this.baseURL}`);

        try {
            // Criar X-CREDENTIALS header (base64 de email:password) conforme documentação
            const credentials = Buffer.from(`${this.email}:${this.password}`).toString('base64');
            
            console.log('📝 POST /auth/login');
            console.log(`X-CREDENTIALS: ${credentials.substring(0, 20)}...`);

            // Endpoint conforme documentação oficial
            const response = await this.client.post('/auth/login', {
                client_id: this.clientId,
                client_secret: this.clientSecret
            }, {
                headers: {
                    'X-CREDENTIALS': credentials
                }
            });

            // Armazenar token
            if (response.data && response.data.access_token) {
                this.token.accessToken = response.data.access_token;
                // Calcular quando o token expira (3600s menos 5min de margem)
                this.token.expiresAt = new Date(Date.now() + (3600 * 1000) - (5 * 60 * 1000));
                
                // Atualizar header de autorização para todas as próximas requisições
                this.client.defaults.headers.common['Authorization'] = `Bearer ${this.token.accessToken}`;
                
                console.log('✅ Autenticação bem-sucedida!');
                console.log(`Token: ${this.token.accessToken.substring(0, 20)}...`);
                console.log(`Expira em: ${this.token.expiresAt.toISOString()}`);
                
                return response.data;
            } else {
                throw new Error('Token não retornado na resposta');
            }
        } catch (error) {
            console.error('❌ Falha na autenticação:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`URL: ${this.baseURL}/auth/login`);
            console.error(`Response: ${JSON.stringify(error.response?.data)}`);
            console.error(`Message: ${error.message}`);
            throw new Error('Falha na autenticação com ClubFix API');
        }
    }

    /**
     * Garante que estamos autenticados
     */
    async ensureAuthenticated() {
        // Se não tem token ou expirou, autentica novamente
        if (!this.token.accessToken || !this.token.expiresAt || new Date() >= this.token.expiresAt) {
            console.log('⚠️ Token expirado ou ausente, renovando...');
            await this.authenticate();
        }
    }

    /**
     * CRIAR CLIENTE - Conforme Documentação Oficial
     * POST /customers
     * Body: { name, document, phone, email, password, address: { street, city, state, zipcode, number } }
     * Response: { id, name, document, phone, email, address }
     * 
     * REGRAS DE SENHA:
     * - Ao menos uma letra maiúscula
     * - Ao menos uma letra minúscula
     * - Ao menos um caracter especial
     * - Ao menos um número
     * - Mínimo 8 caracteres
     * 
     * DOCUMENTO:
     * - document = CPF válido (obrigatório)
     */
    async createCustomer(customerData) {
        await this.ensureAuthenticated();
        
        console.log('\n👤 Criando cliente na API ClubFix...');
        console.log('Dados:', JSON.stringify(customerData, null, 2));

        // Testar múltiplos endpoints
        const endpoints = [
            '/customers',
            '/api/customers',
            '/api-reference/customers'
        ];

        let lastError = null;

        for (const endpoint of endpoints) {
            try {
                console.log(`🔍 Tentando: POST ${endpoint}`);
                const response = await this.client.post(endpoint, customerData);
                
                console.log('✅ Cliente criado com sucesso!');
                console.log(`ID: ${response.data.id}`);
                console.log(`Endpoint correto: ${endpoint}`);
                
                return response.data;
            } catch (error) {
                console.log(`❌ Falhou: POST ${endpoint} (${error.response?.status || 'erro'})`);
                lastError = error;
                continue;
            }
        }

        // Se nenhum endpoint funcionou
        console.error('❌ Nenhum endpoint de criar cliente funcionou');
        console.error(`Último erro: ${lastError.response?.status}`);
        console.error(`Dados: ${JSON.stringify(lastError.response?.data)}`);
        
        throw new Error('Falha ao criar cliente - nenhum endpoint funcionou');
    }

    /**
     * OBTER CLIENTE POR CPF
     * GET /customers/{document}
     */
    async getCustomer(document) {
        await this.ensureAuthenticated();
        
        try {
            const response = await this.client.get(`/customers/${document}`);
            return response.data;
        } catch (error) {
            console.error('❌ Erro ao buscar cliente:');
            console.error(`Status: ${error.response?.status}`);
            
            throw new Error('Falha ao buscar cliente');
        }
    }

    /**
     * LISTAR MARCAS - Conforme Documentação Oficial
     * GET /brands
     * Query: page, per_page
     * Response: { data: [{ id, name, meta: { link } }], links, meta }
     */
    async getBrands(page = 1, perPage = 100, forceRefresh = false) {
        await this.ensureAuthenticated();
        
        // Usar cache se disponível
        if (!forceRefresh && this.cache.brands) {
            console.log('📦 Retornando marcas do cache');
            return this.cache.brands;
        }
        
        try {
            console.log('🔍 Buscando marcas...');
            
            const response = await this.client.get('/brands', {
                params: {
                    page,
                    per_page: perPage
                }
            });
            
            const brands = response.data?.data || response.data || [];
            
            // Atualizar cache
            this.cache.brands = brands;
            this.cache.lastUpdate = new Date();
            
            console.log(`✅ ${brands.length} marcas encontradas`);
            console.log(`Endpoint correto: /brands`);
            
            return brands;
        } catch (error) {
            console.error('❌ Erro ao buscar marcas:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar marcas');
        }
    }

    /**
     * LISTAR MODELOS DE UMA MARCA
     * GET /brands/{brandId}/models
     * Query: page, per_page
     * Response: { data: [{ id, name, brand, meta: { link } }], links, meta }
     */
    async getModels(brandId, page = 1, perPage = 100, forceRefresh = false) {
        await this.ensureAuthenticated();

        if (!brandId) {
            throw new Error('brandId é obrigatório');
        }

        // Usar cache se disponível
        if (!forceRefresh && this.cache.models[brandId]) {
            console.log(`📦 Retornando modelos da marca ${brandId} do cache`);
            return this.cache.models[brandId];
        }

        try {
            console.log(`🔍 Buscando modelos da marca ${brandId}...`);
            
            // Endpoint conforme documentação oficial
            const response = await this.client.get(`/brands/${brandId}/models`, {
                params: {
                    page,
                    per_page: perPage
                }
            });

            const models = response.data?.data || response.data || [];
            
            // Atualizar cache
            this.cache.models[brandId] = models;
            
            console.log(`✅ ${models.length} modelos encontrados`);
            console.log(`Endpoint correto: /brands/${brandId}/models`);
            
            return models;

        } catch (error) {
            console.error('❌ Erro ao buscar modelos:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar modelos');
        }
    }

    /**
     * LISTAR PLANOS - Conforme Documentação Oficial
     * GET /plans
     * Query: page
     * Response: { data: [{ id, name, coverages: [] }], links, meta }
     */
    async getPlans(page = 1, forceRefresh = false) {
        await this.ensureAuthenticated();

        // Usar cache se disponível
        if (!forceRefresh && this.cache.plans) {
            console.log('📦 Retornando planos do cache');
            return this.cache.plans;
        }

        try {
            console.log('🔍 Buscando planos...');
            
            const response = await this.client.get('/plans', {
                params: { page }
            });

            const plans = response.data?.data || response.data || [];
            
            // Atualizar cache
            this.cache.plans = plans;
            
            console.log(`✅ ${plans.length} planos encontrados`);
            
            return plans;

        } catch (error) {
            console.error('❌ Erro ao buscar planos:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar planos');
        }
    }

    /**
     * COTAR TODOS OS PLANOS - Conforme Documentação Oficial
     * GET /quotation
     * Query: model_id, is_used
     * Response: { data: [{ plan, model, maxima, total_premium, device_is_used, franchise }], meta }
     */
    async getQuotation(modelId, isUsed = false) {
        await this.ensureAuthenticated();

        if (!modelId) {
            throw new Error('modelId é obrigatório');
        }

        try {
            console.log(`💰 Buscando cotação para modelo ${modelId} (usado: ${isUsed})...`);
            
            const response = await this.client.get('/quotation', {
                params: {
                    model_id: modelId,
                    is_used: isUsed
                }
            });

            const quotation = response.data?.data || response.data || [];
            
            console.log(`✅ Cotação obtida com sucesso!`);
            console.log(`Endpoint correto: /quotation?model_id=${modelId}&is_used=${isUsed}`);
            
            return quotation;

        } catch (error) {
            console.error('❌ Erro ao buscar cotação:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar cotação');
        }
    }

    /**
     * COTAR UM PLANO ESPECÍFICO
     * GET /plans/{planId}/quotation
     * Query: model_id, is_used
     * Response: { data: { plan, model, maxima, total_premium, device_is_used, franchise }, meta }
     */
    async getQuotationForPlan(planId, modelId, isUsed = false) {
        await this.ensureAuthenticated();

        if (!planId || !modelId) {
            throw new Error('planId e modelId são obrigatórios');
        }

        try {
            console.log(`💰 Buscando cotação do plano ${planId} para modelo ${modelId}...`);
            
            const response = await this.client.get(`/plans/${planId}/quotation`, {
                params: {
                    model_id: modelId,
                    is_used: isUsed
                }
            });

            const quotation = response.data?.data || response.data;
            
            console.log(`✅ Cotação do plano obtida com sucesso!`);
            
            return quotation;

        } catch (error) {
            console.error('❌ Erro ao buscar cotação do plano:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar cotação do plano');
        }
    }

    /**
     * CRIAR ASSINATURA - Conforme Documentação Oficial
     * POST /subscriptions
     * Body: ???  (PRECISA SER DESCOBERTO NA DOCUMENTAÇÃO)
     * Response: { id, customer, device, plan, valor, franchise, status, created_at }
     * 
     * IMPORTANTE: A documentação não mostra o payload completo.
     * Baseando-me nas respostas, provavelmente precisa de:
     * - customer_id
     * - plan_id
     * - model_id
     * - serial_number (IMEI)
     * - is_used
     */
    async createSubscription(subscriptionData) {
        await this.ensureAuthenticated();
        
        console.log('\n📋 Criando assinatura na API ClubFix...');
        console.log('Dados:', JSON.stringify(subscriptionData, null, 2));

        // Testar múltiplos endpoints
        const endpoints = [
            '/subscriptions',
            '/api/subscriptions',
            '/api-reference/subscriptions'
        ];

        let lastError = null;

        for (const endpoint of endpoints) {
            try {
                console.log(`🔍 Tentando: POST ${endpoint}`);
                const response = await this.client.post(endpoint, subscriptionData);
                
                console.log('✅ Assinatura criada com sucesso!');
                console.log(`ID: ${response.data.id}`);
                console.log(`Status: ${response.data.status}`);
                console.log(`Endpoint correto: ${endpoint}`);
                
                return response.data;
            } catch (error) {
                console.log(`❌ Falhou: POST ${endpoint} (${error.response?.status || 'erro'})`);
                lastError = error;
                continue;
            }
        }

        // Se nenhum endpoint funcionou
        console.error('❌ Nenhum endpoint de criar assinatura funcionou');
        console.error(`Último erro: ${lastError.response?.status}`);
        console.error(`Dados: ${JSON.stringify(lastError.response?.data)}`);
        
        throw new Error('Falha ao criar assinatura - nenhum endpoint funcionou');
    }

    /**
     * LISTAR ASSINATURAS
     * GET /subscriptions
     * Query: page
     * Response: { data: [{ id, customer, device, plan, valor, franchise, status, created_at }], links, meta }
     */
    async listSubscriptions(page = 1) {
        await this.ensureAuthenticated();

        try {
            console.log('📋 Listando assinaturas...');
            
            const response = await this.client.get('/subscriptions', {
                params: { page }
            });

            const subscriptions = response.data?.data || response.data || [];
            
            console.log(`✅ ${subscriptions.length} assinaturas encontradas`);
            
            return response.data;

        } catch (error) {
            console.error('❌ Erro ao listar assinaturas:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao listar assinaturas');
        }
    }

    /**
     * OBTER ASSINATURA POR ID
     * GET /subscriptions/{subscriptionId}
     * Response: { id, customer, device, plan, valor, franchise, status, created_at }
     */
    async getSubscription(subscriptionId) {
        await this.ensureAuthenticated();

        if (!subscriptionId) {
            throw new Error('subscriptionId é obrigatório');
        }

        try {
            console.log(`📋 Buscando assinatura ${subscriptionId}...`);
            
            const response = await this.client.get(`/subscriptions/${subscriptionId}`);
            
            console.log(`✅ Assinatura encontrada!`);
            console.log(`Status: ${response.data.status}`);
            
            return response.data;

        } catch (error) {
            console.error('❌ Erro ao buscar assinatura:');
            console.error(`Status: ${error.response?.status}`);
            console.error(`Erro: ${error.response?.data?.message || error.message}`);
            
            throw new Error('Falha ao buscar assinatura');
        }
    }

    /**
     * PROCESSAR PAGAMENTO - Conforme Documentação Oficial
     * POST /subscriptions/{subscriptionId}/payment
     * Body: { creditCard: { number, expirate_at, cvv } }
     * Response: { id, customer, device, plan, valor, franchise, status, created_at }
     * 
     * EXEMPLO CARTÃO DE TESTE:
     * {
     *   "creditCard": {
     *     "number": "5448280000000007",
     *     "expirate_at": "1228",  // MMAA formato
     *     "cvv": "123"
     *   }
     * }
     * 
     * OBSERVAÇÃO DA DOCUMENTAÇÃO:
     * "Em ambientes de testes, por vezes a API do Gateway de pagamento pode 
     *  nos retornar um status code nas faixas 400 ou 500, mesmo quando os 
     *  dados solicitados estão coerentes. Recomendamos fortemente que a 
     *  requisição seja reprocessada, até que retorne uma resposta positiva."
     */
    async processPayment(subscriptionId, cardData) {
        await this.ensureAuthenticated();

        if (!subscriptionId) {
            throw new Error('subscriptionId é obrigatório');
        }

        if (!cardData || !cardData.number || !cardData.expirate_at || !cardData.cvv) {
            throw new Error('Dados do cartão incompletos');
        }

        console.log(`\n💳 Processando pagamento para assinatura ${subscriptionId}...`);
        console.log('Dados do cartão:', {
            number: cardData.number.substring(0, 4) + '****' + cardData.number.substring(cardData.number.length - 4),
            expirate_at: cardData.expirate_at,
            cvv: '***'
        });

        // Testar múltiplos endpoints
        const endpoints = [
            `/subscriptions/${subscriptionId}/payment`,
            `/api/subscriptions/${subscriptionId}/payment`,
            `/api-reference/subscriptions/${subscriptionId}/payment`
        ];

        let lastError = null;

        for (const endpoint of endpoints) {
            try {
                console.log(`🔍 Tentando: POST ${endpoint}`);
                const response = await this.client.post(endpoint, {
                    creditCard: cardData
                });
                
                console.log('✅ Pagamento processado com sucesso!');
                console.log(`Status: ${response.data.status || 'PROTECTED'}`);
                console.log(`Endpoint correto: ${endpoint}`);
                
                return response.data;
            } catch (error) {
                console.log(`❌ Falhou: POST ${endpoint} (${error.response?.status || 'erro'})`);
                lastError = error;
                
                // Se for erro 400 ou 500, pode ser temporário
                if (error.response?.status >= 400 && error.response?.status < 600) {
                    console.warn('⚠️ Erro temporário, tentando próximo endpoint...');
                }
                continue;
            }
        }

        // Se nenhum endpoint funcionou
        console.error('❌ Nenhum endpoint de pagamento funcionou');
        console.error(`Último erro: ${lastError.response?.status}`);
        console.error(`Dados: ${JSON.stringify(lastError.response?.data)}`);
        
        throw new Error('Falha ao processar pagamento - nenhum endpoint funcionou');
    }
    }

    /**
     * Limpar cache
     */
    clearCache() {
        this.cache = {
            brands: null,
            models: {},
            plans: null,
            lastUpdate: null
        };
        console.log('🗑️ Cache limpo');
    }
}

// Criar uma instância única (singleton)
const clubfixService = new ClubFixServiceV3();

module.exports = clubfixService;
